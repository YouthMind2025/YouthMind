# YouthMind Recommendation Engine Validation Configuration
# Copy this file to .env and update with your values

# Base URL for the application
BASE_URL=http://localhost:8080

# User authentication token (required for most API tests)
# Get this from your authentication system
TOK=your_user_token_here

# Admin authentication token (required for admin endpoint tests)
# Get this from your authentication system
ADMIN_TOK=your_admin_token_here

# Test user ID (will be generated if not provided)
USER_ID=test-user-12345

# Optional: Override default timeouts
# HEALTH_CHECK_TIMEOUT=90
# RATE_LIMIT_WINDOW=60
# SCHEDULER_WAIT_TIME=45

# Optional: Override Redis connection details
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional: Override database connection details
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=youthmind
# DB_USER=youthmind
# DB_PASSWORD=your_password_here
